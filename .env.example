# Copia a .env y completa. .env nunca se sube a Git.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=<solo para scripts/setup-db.ps1>
APP_DB_NAME=d8_demo
APP_DB_USER=d8_app
APP_DB_PASSWORD=<generada por setup-db.ps1 si se deja vacía>
DATABASE_URL=postgresql://d8_app:<password>@localhost:5432/d8_demo
# Contraseña de los usuarios demo creados por app.seed (mínimo 10 caracteres)
DEMO_PASSWORD=<elige una>
# Carpeta privada de archivos (relativa a la raíz del repo)
STORAGE_DIR=storage
# URL pública de la interfaz (destino del QR de las alertas)
APP_BASE_URL=http://localhost:3010
# true detrás de HTTPS
COOKIE_SECURE=false

# Correo (sin SMTP_HOST los correos se guardan como .eml en storage/outbox)
EMAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=8D PRO <no-reply@tu-dominio.com>
